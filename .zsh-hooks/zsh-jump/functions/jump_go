jump_go () {
	local key="$1"
	local file="$HOME/.chpwd-recent-dirs"
	local directory
	
	if is_empty "$file"; then 
		print -n "[*] The file it's empty. Miuw \n"
		return 1 
	fi

	directory=$(search_directory "$key" "$file")
	
	if [[ -z "$directory" ]]; then
		return 1
	fi

	if [[ -d "$directory" ]]; then
		cd -- "$directory" || return 1
		return 0
	fi

	remove_file "$key" "$file"
	update_file "$key" "$file"
	return 1
}
