jump_remove() {
	local key="$1"
	local file="$HOME/.chpwd-recent-dirs"
	local directory

	if is_empty "$1"; then 
		print -n "\n[*] The file it's empty. Miuw \n"
		return 1 
	fi

	directory=$(search_directory "$key" "$file")

	if [[ -z "$directory" ]]; then
		return 1
	fi

	remove_file "$key" "$file"
	update_file "$key" "$file"
  return 0 
}
