jump_edit() {
	local file="$HOME/.chpwd-recent-dirs"

	if type -p "nvim"; then
		nvim $file 2>/dev/null
	elif type -p "vim"; then
		vim $file 2>/dev/null
	elif type -p  "vi"; then
		vi $file 2>/dev/null
	elif type -p  "nano"; then
		nano $file 2>/dev/null
	else
		echo "I haven't been able to find a code editor"
	fi

}
