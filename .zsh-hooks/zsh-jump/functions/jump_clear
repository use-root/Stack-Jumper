jump_clear() {
	
	local file="$HOME/.chpwd-recent-dirs"
	local -l option

	if is_empty "$file"; then 
		print -n "[*] The file it's empty. Miuw \n"
		return 1 
	fi

	print -n "\n[!] Erase all recent directories? [y/N] "
	read -r option
	case $option in 
		  y|yes)
				[[ -e "$file" ]]  && : >| "$file"
				print "[*] Recent directories cleared." 
			;;
			*)
        print "[*] Cancelled."
			;;
	esac
}
