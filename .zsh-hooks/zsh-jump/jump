jump() {
  local key_arg
  local OPTIND=1
	while getopts "hlceg:r:" flag "$@"; do
		case "$flag" in
		l) 
			cat ~/.chpwd-recent-dirs
			;;
		c) jump_clear
			;;
		e) 
			jump_edit
			;;
		g) 
			jump_go "$OPTARG" 
			;;
		r) 
			jump_remove "$OPTARG" 
			;;
		h) 
			help_menu
			;;
		\?)
			help_menu
       ;;
		esac
	done
}	
