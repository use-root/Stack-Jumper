jump_save_list() {
	local key=$(update_key)
	local file="$HOME/.chpwd-recent-dirs"
	local current_dir="$PWD"


	uid=$(stat "$current_dir" | grep "Uid" | awk '{print $3}' | sed -e 's/[^0-9]//g')
	gid=$(stat "$current_dir" | grep "Gid" | awk '{print $4}' | sed -e 's/[^0-9]//g')


	if [[ "$uid" -eq 0 && "$gid" -eq 0 ]]; then
		return 1
	fi
	
	exist_dir_in_file=$(grep -E "[0-9]+\s$current_dir$" "$file")
	
	if [ -z "$exist_dir_in_file" ]; then
		((key++))
		echo "$key $current_dir" >> "$file"
		return 0
	fi
}
